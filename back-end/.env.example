# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globesync?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globesync_test?schema=public"

# Docker Postgres Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=globesync
POSTGRES_PORT=5432

# Application Server
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=gs-access-secret-change-in-production-must-be-32chars-min
JWT_REFRESH_SECRET=gs-refresh-secret-change-in-production-must-be-32chars-min
FRONTEND_URL=http://localhost:5173

# CORS Allow-list (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Request Size Limit & Rate Limiting
REQUEST_SIZE_LIMIT=10mb
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=600

# S3-Compatible Object Storage (MinIO)
STORAGE_DRIVER=disk
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=globesync-uploads

# Swagger Protection in Non-Dev
SWAGGER_USER=admin
SWAGGER_PASSWORD=globesync-admin
PROTECT_SWAGGER=false
