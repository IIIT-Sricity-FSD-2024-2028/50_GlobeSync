# GlobeSync Frontend — Environment Variables Template
# Copy this file to .env before running `npm run dev`.

# The base URL of the running NestJS API backend (back end runs on port 3001)
VITE_API_BASE_URL=http://localhost:3001

# Show the one-click demo account buttons on the login page.
# Set to false for any public / production deployment.
VITE_SHOW_DEMO_ACCOUNTS=true
